scwin.btn_help_contents_onclick = function(e) {
    let tindex  = this.getUserData("userData1");
	let tgubun  = this.getUserData("userData3");
	let fileSysName = "";
	let m_url = "";
	let u_url = "";
	let openPopupUrl = "";
	let openPopupName = "";
	let openPopupWidth = "";

    //나의전자소송
    if(tindex == "01"){
		fileSysName = "/help/도움말_나의전자소송.pdf"
	}
    //서류제출
    else if(tindex == "02"){
		fileSysName = "/help/도움말_서류제출.pdf"
    }
    //제증명
    else if(tindex == "03"){
		fileSysName = "/help/도움말_제증명.pdf"
    }
    //송달문서확인
    else if(tindex == "04"){
		fileSysName = "/help/도움말_송달문서확인.pdf"
    }
    //납부환급
    else if(tindex == "05"){
		fileSysName = "/help/도움말_납부환급.pdf"
    }
    //나홀로소송
    else if(tindex == "06"){
		fileSysName = "/help/도움말_나홀로소송.pdf"
    }
    if(scutilo.isEmpty(m_url) && scutilo.isEmpty(u_url) && scutilo.isEmpty(fileSysName)){
        return false;
    }

	if(tgubun == "youtu"){
		if (psp.isMobileApp() === true) {
        	psp.windowOpen(u_url);
    	} else {
			window.open(u_url);
		}
	}else if(tgubun == "link"){
		window.open(fileSysName,'pop', 'location=no, directories=no, resizable=yes, status=no, toolbar=no, menubar=no, width=680, height=800, scrollbars=yes');
		return false;
	}else if(tgubun == "linkPDF"){
		let port = document.location.port;
		let hostname = scutilo.isEmpty(port) ? document.location.hostname : document.location.host;
		let contextRoot = psputils.isLocal() ? "" : psp.CONTEXT_ROOT;
		let baseUrl = hostname + contextRoot;
		let url = '';
		if (psp.isIosApp() === true) {
			url = psputils.IOS_HREF + fileSysName;
			psp.windowOpen(url);
		} else {
			url = "https://" + baseUrl + fileSysName;
			psp.windowOpen(url);
		}
	}else if(tgubun == "openPopup"){
		var param = {
			"dma_paramData": {
				"initTabIdx": "",
				"openerInputId":""
			}
		}
		var h = window.screen.availHeight;
		psp.openBrowserPopup(openPopupUrl, openPopupName, param, 1200, h, null, false);
	}
};


