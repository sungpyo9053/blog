scwin.anc_courtInfoOpen_onclick = function(e) {
    var ancId = this.org_id;

    var courtInfoPage = ancId.substr(4,20);
_debug("[anc_courtInfoOpen_onclick] courtInfoPage------------- " + courtInfoPage);

    if("family" == courtInfoPage) { // 전자가족관계등록시스템
        courtInfoPage = "https://efamily.scourt.go.kr/cs/CsBltnWrtGuide.do?bltnbordId=0000010&guideCd=0000010001&guideYn=Y";
        psp.windowOpen(courtInfoPage);

    } else if("pjg" == courtInfoPage) {
        //전자공탁 연동
        var url = psp.prpt.getFilePropVal(psp.C.FPPKEY_URL_LINK_PJG);
        var opts = 'width=1100, height=500, directories=yes, location=yes, menubar=yes, scrollbars=yes, status=yes, resizable=yes, toolbar=yes';
        var vlnkSsoToken = psp.ss.get("ssoToken", true);

        if ( scutilo.isNotEmpty(vlnkSsoToken) ) { // 정상로그인 세션
            url = url + "lnkindex.on?lnkParamOn=" + vlnkSsoToken;
        } else {
            url = url + "index.on";
        }
        _debug("[전자공탁 로그인연동] url------------- " + url);
        psp.windowOpen(url, '', opts);

    } else if("openScourt" == courtInfoPage) { // 정보공개청구
        courtInfoPage = "https://portal.scourt.go.kr/pgp/index.on?m=PGP301M01";
        psp.windowOpen(courtInfoPage);

    } else if("recOffer" == courtInfoPage) { // 판결서 사본제공 신청
        courtInfoPage = "https://portal.scourt.go.kr/pgp/index.on?m=PGP201M01A&l=Y&c=300";
        psp.windowOpen(courtInfoPage);

    } else if("finalruling" == courtInfoPage) { // 판결서 인터넷 열람
        courtInfoPage = "https://portal.scourt.go.kr/pgp/index.on?m=PGP202M01&l=Y&c=400";
        psp.windowOpen(courtInfoPage);

    } else if("reqScourt" == courtInfoPage) { // 법원에 바란다
        courtInfoPage = "https://www.scourt.go.kr/portal/advice/AdviceList.work";
        psp.windowOpen(courtInfoPage);

    } else {
        psp.go_url(courtInfoPage);
    }

}

