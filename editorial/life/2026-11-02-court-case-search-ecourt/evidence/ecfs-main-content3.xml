    var searchword = ibx_searchword.getValue();

    if(!scutilo.isNotEmpty(searchword)) {
        scutilo.showMsg(scglblo.MSG.WARN, scutilo.getMsg(pspmsg.PSP.W_1019, "양식명"), function() {ibx_searchword.focus();}); //W_1019: "[<%s>] 항목을 입력하세요."
