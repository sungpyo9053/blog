scwin.onpageload = function() {

    com.executeSubmission(sbm_selMcodes);

    dma_search.set("elpFaqCtgCd","0");
    dma_search.set("faqQstnGubun","Q");
    dma_search.set("cateKind","02");
    dma_search.set("pageNo","1");
    dma_search.set("pageSize","5");
    dma_search.set("totalYn","Y");

    com.executeSubmission(sbm_selMainFaqList);
};


scwin.onpageunload = function() {

};


scwin.sbm_selMainFaqList_submitdone = function() {

    var faqMclNm = "";
    var faqMclNmOld = "";
    var faqQstnCtt = "";
    var seqnum = "";
    var gubun = "";
    var ancObjNm = "";
    var grpObjNm = "";
    var ancObj = null;
    var grpObj = null;
    var ancVal = "";
    var mark = "";
    var markVal = 0;

    dlt_faqLst.sort("gubunNm", 0);

    for(var i=0; i < dlt_faqLst.getRowCount(); i++) {
        faqMclNm   = dlt_faqLst.getCellData(i, "gubunNm");
        gubun      = dlt_faqLst.getCellData(i, "gubun");
        faqQstnCtt = dlt_faqLst.getCellData(i, "title");
        seqnum  = dlt_faqLst.getCellData(i, "seqnum");

        if(faqMclNm != faqMclNmOld){
            markVal++;
        }

        if(1 == markVal){
            mark = "mark";
        } else if(2 == markVal){
            mark = "mark mk2";
        } else if(3 == markVal){
            mark = "mark mk3";
        } else if(4 == markVal){
            mark = "mark mk4";
        } else if(5 == markVal){
            mark = "mark mk5";
        }

        ancObjNm = "anc_jaju" +(1+i);
        grpObjNm = "grp_jaju" +(1+i);

        ancObj = $p.getComponentById(ancObjNm);
        grpObj = $p.getComponentById(grpObjNm);

        ancVal = "<span class='" + mark + "'>" + faqMclNm + "</span><span class='lst_txt'>" + faqQstnCtt + "</span>";
        ancObj.setValue(ancVal);

        ancObj.setUserData("seqnum", seqnum);
        ancObj.setUserData("gubun", gubun);

        grpObj.setUserData("seqnum", seqnum);
        grpObj.setUserData("gubun", gubun);

        faqMclNmOld = faqMclNm;
    }


}

/**
 * 소송안내마당 종류별 클릭
 *
 * ============= ============ ==========================
