ceptNo":null,"sort":"1","pushSndngYn":null,"searchType":null,"keyword":null,"searchBeginDt":null,"searchEndDt":null,"searchPushSndngYn":null,"searchSysSeCode":null,"searchRceptNo":null,"answerCn":"","answerDelYn":"","answerRegrId":"","answerRegDt":"","thumbnailAtchmnflId":null,"thumbnailAtchmnflSn":null,"thumbnailAtchmnflStreNm":"","thumbnailColSn":"0","thumbnailRowSn":"13","rowNo":"40","thumbnailDescr":"","excelYn":"N","pdfSn":"N","noticePopTypecd":"","answerVal":"","bbsName":""},{"ssUserId":"","ssUserNm":"","ssUserIp":"","ssLoginTime":"","ssPasswd":"","ssInsttId":"","ssInsttNm":"","ssTelno":"","ssMobileno":"","ssEmail":"","ssLastLoginDe":"","ssLastLoginDt":"","ssPasswdChgprarDe":null,"ssLoginFailrCnt":0,"ssLoginLockYn":null,"confmStatcd":null,"ssPwChkDay":0,"sadmin":false,"koroadUserYn":null,"gotpTypecd":"","gotpSn":"","licnExmName":"","sysMngrYn":"","ssPrsnlInfoYn":"","prsnlInfoAccsYn":"","dfsReqstStat":"","workMode":"","pageIndex":1,"pageUnit":10,"pageSize":10,"firstIndex":0,"lastIndex":1,"recordCountPerPage":10,"totCnt":69,"orderBy":"","no":"40","bbscttSn":"5384","bbsTypecd":"00503","bbsTypenm":"FAQ","bbscttSj":"민간개방이 무엇인가요?","ctgryCd":"00401","ctgryNm":"발급","insttId":"KOMSCO","insttNm":"한국조폐공사","bbscttCn":"<p style=\"margin-left:10.0pt\">▶ 민간개방은 모바일 신분증<span style=\"font-family:맑은 고딕\">(</span>주민등록증<span style=\"font-family:맑은 고딕\">, </span>운전면허증<span style=\"font-family:맑은 고딕\">, </span>국가보훈등록증<span style=\"font-family:맑은 고딕\">, </span>외국인등록증<span style=\"font-family:맑은 고딕\">, </span>장애인등록증<span style=\"font-family:맑은 고딕\">)</span>을 정부 앱 설치 없이 국민이 자주 사용하는 민간 앱에서 발급 및 이용할 수 있도록 한 것입니다<span style=\"font-family:맑은 고딕\">.</span></p>\n\n\n<p style=\"margin-left:10.0pt\">※ 홈 &gt; 민간개방 &gt; 민간개방이란 메뉴를 통해 상세한 내용을 확인하실 수 있습니다.</p>\n\n\n<p style=\"margin-left:10.0pt\">▶ 신분증 별 발급 가능 민간앱</p>\n\n\n<table style=\"width:100%; border-collapse:collapse; border:1px solid #666; color:#000;\">\n  <colgroup>\n  \t<col style=\"width:27%;\">\n    <col style=\"width:25%;\">\n    <col style=\"width:48%;\">\n  </colgroup>\n <tbody>\n  \n \n  <tr>\n   \n \n   <td style=\"border:1px solid #666; padding:8px; color:#000; background-color:#e5e5e5; text-align:center\"><strong>신분증 종류</strong></td>\n \n   <td style=\"border:1px solid #666; padding:8px; color:#000; background-color:#e5e5e5; text-align:center\"><strong>발급방법</strong></td>\n \n   <td style=\"border:1px solid #666; padding:8px; color:#000; background-color:#e5e5e5; text-align:center\"><strong>발급 간능한 민간앱</strong></td>\n \n  </tr>\n \n  <tr>\n   \n \n   <td style=\"border:1px solid #666; padding:8px; color:#000; text-align:center;\">\n <p>주민등록증</p>\n\n <p>운전면허증</p>\n\n <p>국가보훈증＊</p>\n\n <p>외국인드록증</p>\n </td>\n \n   <td colspan=\"1\" rowspan=\"2\" style=\"border:1px solid #666; padding:8px; color:#000;\">\n <p>IC 카드 발급 및 현장 QR 발급</p>\n </td>\n \n   <td style=\"border:1px solid #666; padding:8px; color:#000;\">\n <p>삼성월렛, 네이버, 카카오뱅크, 토스,</p>\n\n <p>NH올원뱅크, KB스타뱅킹, 우리WON뱅킹,</p>\n\n <p>하나은행, 신한슈퍼SOL, i-ONE Bank(개인)</p>\n </td>\n \n  </tr>\n \n  <tr>\n   \n \n   <td style=\"border:1px solid #666; padding:8px; color:#000; text-align:center;\">장애인등록증</td>\n \n   <td>\n <p>삼성월렛, 네이버, NH올원뱅크,&nbsp;</p>\n\n <p>우리WON뱅킹,&nbsp;하나은행, 신한슈퍼SOL,</p>\n\n <p>i-ONE Bank(개인)</p>\n </td>\n \n  </tr>\n \n </tbody>\n\n</table>\n\n\n<p style=\"margin-left:10.0pt\">※ IC 신분증이 있는 경우 모든 민간앱에서 발급 가능하나, IC 신분증이 없는 경우에는 현장에서 QR 발급을 통해 네이버, 카카오뱅크, 토스에서 발급이 가능합니다.</p>\n\n\n<p style=\"margin-left:10.0pt\">* 국가보훈등록증은 IC 카드 발급만 가능</p>\n\n\n<p style=\"margin-left:10.0pt\">&nbsp;</p>\n\n\n<p style=\"margin-left:10.0pt\">▶ 민간앱 사용 가능 조건</p>\n\n\n<p style=\"margin-left:10.0pt\">홈 &gt; 민간개방 &gt; 서비스진입경로 메뉴를 통해 상세한 내용을 확인하실 수 있습니다.</p>\n\n\n<table style=\"width:100%; border-collapse:collapse; border:1px solid #666; color:#000;\">\n   <colgroup>\n  \t<col style=\"width:27%;\">\n    <col style=\"width:25%;\">\n    <col style=\"width:48%;\">\n  </colgroup>\n \n <tbody>\n  \n \n  <tr>\n   \n \n   <td style=\"border:1px solid #666; padding:8px; color:#000; background-color:#e5e5e5; text-align:center\"><strong>운영체계</strong></td>\n \n   <td style=\"border:1px solid #666; padding:8px; color:#000; background-color:#e5e5e5; text-align:center\"><strong>버전 및 종류</strong></td>\n \n   <td style=\"border:1px solid #666; padding:8px; color:#000; background-color:#e5e5e5; text-align:center\"><strong>사용 가능한 민간앱</strong></td>\n \n  </tr>\n \n  <tr>\n   \n \n   <td colspan=\"1\" rowspan=\"2\" style=\"border:1px solid #666; padding:8px; color:#000; text-align:center;\">AOS</td>\n \n   <td style=\"border:1px solid #666; padding:8px; color:#000;\">안전지갑* 지원 스마트폰</td>\n \n   <td style=\"border:1px solid #666; padding:8px; color:#000;\">삼성월렛, 카카오뱅크, 토스, 네이버, KB스타뱅크</td>\n \n  </tr>\n \n  <tr>\n   \n \n   <td style=\"border:1px solid #666; padding:8px; color:#000;\">\n <p>Android 8 이상의</p>\n\n <p>모든 스마트폰</p>\n </td>\n \n   <td style=\"border:1px solid #666; padding:8px; color:#000;\">\n <p>NH올원뱅크, 우리WOW뱅킹 , 하나은행,</p>\n\n <p>신한 슈퍼 SOL, I-ONE Bank(개인)</p>\n </td>\n \n  </tr>\n \n  <tr>\n   \n \n   <td colspan=\"1\" rowspan=\"2\" style=\"border:1px solid #666; padding:8px; color:#000; text-align:center;\">iOS</td>\n \n   <td style=\"border:1px solid #666; padding:8px; color:#000;\">iOS 15 이상의 iPhone</td>\n \n   <td style=\"border:1px solid #666; padding:8px; color:#000;\">\n <p>카카오뱅크, 토스, KB스타뱅킹, NH올원뱅크,</p>\n\n <p>우리WOW뱅킹 , I-ONE Bank(개인)</p>\n </td>\n \n  </tr>\n \n  <tr>\n   \n \n   <td style=\"border:1px solid #666; padding:8px; color:#000;\">iOS 16 이상의 iPhone</td>\n \n   <td style=\"border:1px solid #666; padding:8px; color:#000;\">네이버, 하나은행, 신한 슈퍼SOL</td>\n \n  </tr>\n \n </tbody>\n\n</table>\n\n\n<p>* 발급된 모바일 신분증 데이터를 암호화하여 일반 앱과 완전히 격리된 공간에 보관하는 '안심 금고' 입니다. 스마트폰 분실이나 해킹으로부터 개인정보를 안전하게 지킵니다.(Android 14 이상 One UI 6.1 이상 삼성 갤럭시 스마트폰에서 사용 가능)</p>\n\n\n<p>※ 안전지갑을 제외한 스마트폰에서는 하나의 앱에서만 신분증을 발급받아 사용할 수 있습니다.</p>\n\n\n<p>(예시 : 네이버에서 신분증을 발급받은 후 카카오뱅크에서 신분증을 발급받으면, 네이버의 신분증은 삭제됩니다.)</p>\n","inqireCnt":294,"atchmnflId":0,"clsdrYn