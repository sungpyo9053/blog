scwin.pageMoveEvent = function(point) {
    const movPoint = point || ''
    if (scutilo.isEmpty(movPoint)) {
        scutilo.showMsg(scglblo.MSG.WARN,"서비스 점검중입니다.\n 메인페이지로 이동하겠습니다.",()=>{
            $p.url('index.on')
        })
    } else {
        $p.url(`/pgj/ui/pgj100/${movPoint}.xml`)
    }
}

/**
