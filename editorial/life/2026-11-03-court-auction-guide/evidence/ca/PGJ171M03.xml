 * ============= ============ ==========================
 */
scwin.onpageload = function() {

    /* 메뉴 */
    if(!scutilo.isEmpty(scwin.pgmId)){
       $p.main().wfm_side.scope.scwin.menuFocus(scwin.pgmId);
    }

    //이미지 맵 반응형 처리
    $('#mf_stepImg1').rwdImageMaps();  // 화면오류로 주석처리
};

scwin.onpageunload = function() {

};


/**
 * 메뉴 클릭 시 이동
 *
 *
 * ============= ============ ==========================
 *  Date          Author       Description
 * ------------- ------------ --------------------------
 *  2026.06.08    김기석       [NELS] 최초생성
 *  2026.07.07    김기석       [26A-PGJ-0030] 임차인통지서 QR코드를 통한 볍원경매정보 서비스 제공
 * ============= ============ ==========================
 */
scwin.menuMove = function(pgmId) {
   const flag = pgmId;
   var opts = 'width=1100, height=700, directories=yes, location=yes, menubar=yes, scrollbars=yes, status=yes, resizable=yes, toolbar=yes';

    switch (flag) {
        case "PGJ171P02": // 소액보증금액표

            /********* Popup Settings *********/
            var winW = window.innerWidth;
            var winH = window.innerHeight;

            /* default popup size */
            var popupW = 1050;
            var popupH = 900;

            var popupX = (winW/2) - (popupW/2);
            var popupY = (winH/2) - (popupH/2);

            var options = {
                id: "PGJ171P02",
                type: "wframePopup",
                modal: true,
                useControl : "true",
                controls : {minimize: false, maximize: false, close : true},
                popupName: "소액보증금액표",
                top:popupY,
                left:popupX,
                width:popupW,
                height:popupH
            };

            $p.openPopup("/pgj/ui/pgj100/PGJ171P02.xml", options);

            break;

        case "PSP720M24": // 권리신고 및 배당요구신청서 양식

            window.open("https://ecfs.scourt.go.kr/psp/index.on?m=PSP720M24", '_blank', opts);

            break;

        case "PGJ159M00": // 경매사건검색
             $p.url("/pgj/ui/pgj100/PGJ159M00.xml");
            break;

        case 'PSPMAIN': //전자소송포털 사건검색

            window.open("https://ecfs.scourt.go.kr/psp/index.on", '_blank', opts);

            break;

        case 'PSP720M11': //사법지원 안내

            window.open("https://ecfs.scourt.go.kr/psp/index.on?m=PSP720M11", '_blank', opts);

            break;

        case 'HELPLAW': //법률구조 플랫폼

            window.open("http://www.helplaw24.go.kr");

            break;

        case 'PGJ171M01': //경매절차 안내

            $p.url("/pgj/ui/pgj100/PGJ171M01.xml");

            break;

    }

}]]></script>
