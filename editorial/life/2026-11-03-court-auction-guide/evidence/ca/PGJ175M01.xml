    $('#mf_stepImg1').rwdImageMaps();
};

scwin.onpageunload = function() {

};

/**
 *매수신청 대리안내 다운로드
 *
 * ============= ============ ==========================
 *  Date          Author       Description
 * ============= ============ ==========================
 *  2022.12.07.   나해준                    [NELS]최초 생성
 *  2026.09.18.   강은숙                    [26A-PGJ-0042] 감정평가서 팝업화면 안내문구 및 안내 메세지 추가
 * ============= ============ ==========================
 */
scwin.anc_prchAplyPrxyDwl_onclick = function() {
    /* 현재 데이터가 없어 다른 파일로 대체한 추후에 매수신청 대리 안내 파일로 대체 해야함 TO-DO*/
    const params = { "dma_downInfo": {
        cortAuctnNtcEtcDvsCd : "0005401",
        cortAuctnNtcMtrSeq : 26,
        cortAuctnAtflSeq : 4,
    } }

    const xhr = new XMLHttpRequest();
    xhr.open('POST', "/pgj/pgjComm/000Blob.on", true);
    xhr.setRequestHeader('Content-Type', 'application/json');
    com.setHeader(xhr); // SCHeader setting
    xhr.responseType = 'blob';
    xhr.onreadystatechange = function() {
        if (this.readyState === XMLHttpRequest.DONE) {
            if (this.status === 200) {
                let filename = "";
                let contentDisposition = this.getResponseHeader('Content-Disposition');
                if (contentDisposition && contentDisposition.indexOf('attachment') !== -1) {
                    const filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                    let matches = filenameRegex.exec(contentDisposition);
                    if (matches != null && matches[1]) {
                        filename = matches[1].replace(/['"]/g, '');
                    }
                }
                const blob = new Blob([this.response], { type: 'application/octet-stream' });
                const downloadLink = document.createElement('a');
                downloadLink.href = URL.createObjectURL(blob);
                downloadLink.download = decodeURIComponent(filename) || 'unknown'; // 한글명 대응
                downloadLink.click();
            } else {
                scutilo.showMsg(scglblo.MSG.ERROR, '파일 다운로드에'); //<%s> 실패하였습니다.
            }
        }
    };
    xhr.send(JSON.stringify(params));
};
]]></script>
