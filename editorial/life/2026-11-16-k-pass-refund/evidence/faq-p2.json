{"pageInfo":{"alUserSn":null,"cardUid":null,"ccmSeCd":null,"userSn":null,"userId":null,"userNm":null,"authorCode":null,"searchCondition":"1","searchKeyword":"","searchBgnde":null,"searchEndde":null,"searchUseYn":null,"message":null,"useYn":null,"frstRgstId":null,"frstRgstDt":null,"lastUpdusrId":null,"lastUpdtDt":null,"refrnSn":null,"atchFileCd":null,"alUserCi":null,"foreignYn":null,"kpassChgYn":null,"pageMode":null,"pageUnit":10,"pageIndex":2,"firstIndex":10,"lastIndex":20,"pageSize":10,"paginationInfo":{"currentPageNo":2,"recordCountPerPage":10,"pageSize":10,"totalRecordCount":59,"totalPageCount":6,"firstPageNoOnPageList":1,"lastPageNoOnPageList":6,"firstRecordIndex":10,"lastRecordIndex":20,"lastPageNo":6,"firstPageNo":1},"loginUserId":null,"bbsSn":null,"nttSn":null,"nttSj":null,"nttCn":null,"upprNtceYn":null,"upprNtceBeginDt":null,"upprNtceEndDt":null,"inqireNum":null,"sortOrdr":null,"pwd":null,"userEmail":null,"alUserEmail":null,"faqCtgry":"","publicYn":null,"qnaTy":null,"osTy":null,"osVer":null,"appVer":null,"webVer":null,"alUserNm":null,"alUserMpno":null,"receptionTy":null,"verifyWord":null,"oriVerifyWord":null,"str":null,"kpassYn":null,"csm":null,"offset":10},"serviceInfoVo":{"alUserSn":null,"cardUid":null,"ccmSeCd":null,"userSn":null,"userId":null,"userNm":null,"authorCode":null,"searchCondition":"1","searchKeyword":"","searchBgnde":null,"searchEndde":null,"searchUseYn":null,"message":null,"useYn":null,"frstRgstId":null,"frstRgstDt":null,"lastUpdusrId":null,"lastUpdtDt":null,"refrnSn":null,"atchFileCd":null,"alUserCi":null,"foreignYn":null,"kpassChgYn":null,"pageMode":null,"pageUnit":10,"pageIndex":2,"firstIndex":10,"lastIndex":20,"pageSize":10,"paginationInfo":{"currentPageNo":2,"recordCountPerPage":10,"pageSize":10,"totalRecordCount":59,"totalPageCount":6,"firstPageNoOnPageList":1,"lastPageNoOnPageList":6,"firstRecordIndex":10,"lastRecordIndex":20,"lastPageNo":6,"firstPageNo":1},"loginUserId":null,"bbsSn":null,"nttSn":null,"nttSj":null,"nttCn":null,"upprNtceYn":null,"upprNtceBeginDt":null,"upprNtceEndDt":null,"inqireNum":null,"sortOrdr":null,"pwd":null,"userEmail":null,"alUserEmail":null,"faqCtgry":"","publicYn":null,"qnaTy":null,"osTy":null,"osVer":null,"appVer":null,"webVer":null,"alUserNm":null,"alUserMpno":null,"receptionTy":null,"verifyWord":null,"oriVerifyWord":null,"str":null,"kpassYn":null,"csm":null,"offset":10},"list":[{"rownum":21,"nttSn":"NTT00000000000081456","nttSj":"모두의카드를 따로 구입해야 하나요?","faqCtgry":"CT05","faqAnswer":"<p><span style=\"background-color: transparent;\">이용하시던 K-패스(또는 알뜰교통카드)카드 그대로 사용이 가능합니다.</span></p><p><span style=\"background-color: transparent;\">모두의카드</span>는 K-패스의 정기권 형태의 환급 정책 이름으로, 모두의카드(K-패스 카드)를 이용하여 대중교통비를 환급하시는 경우 다음 달 자동으로 큰 혜택을 적용하여 환급해드립니다.</p><p><span style=\"background-color: transparent;\">모두의카드</span>&nbsp;발급 후 모두의카드&nbsp;홈페이지 또는 앱에서 회원가입을 하셔야 적립이 가능합니다.</p><p><b>&nbsp;회원가입 이전 사용분은 소급처리 되지 않는 점 이용에 참고부탁드립니다.</b></p>","sortOrdr":"1","frstRgstDt":"2025-12-22"},{"rownum":35,"nttSn":"NTT00000000000081265","nttSj":"BC하나카드-> 하나카드(단독상품)  또는 BC우리카드 -> 우리카드(단독상품)으로 재발급/갱신된 경우 카드 변경 꼭 해주세요","faqCtgry":"CT04","faqAnswer":"<p style=\"\" noto=\"\" sans=\"\" korean\",=\"\" \"malgun=\"\" gothic\",=\"\" sans-serif;\"=\"\"><font color=\"#333333\">하나카드와 우리카드가 단독 상품으로 출시되었습니다.&nbsp;</font></p><p style=\"\" noto=\"\" sans=\"\" korean\",=\"\" \"malgun=\"\" gothic\",=\"\" sans-serif;\"=\"\"><font color=\"#333333\"><b>BC카드 이용중 재발급 또는 갱신된 카드사 단독상품일 경우 변경된 카드정보를<b> </b>모두의카드<b>에 등</b>록 후 이용해주세요.&nbsp;</b></font></p><p style=\"\" noto=\"\" sans=\"\" korean\",=\"\" \"malgun=\"\" gothic\",=\"\" sans-serif;\"=\"\"><font color=\"#333333\">단독 상품으로 카드가 변경된 경우 변경된 카드정보를 모두의카드에 등록한 일자부터 적립됩니다.&nbsp;</font></p><p style=\"\" noto=\"\" sans=\"\" korean\",=\"\" \"malgun=\"\" gothic\",=\"\" sans-serif;\"=\"\"><font color=\"#333333\">카드변경은 홈페이지나 앱에서 로그인 후 MY &gt; 내정보&nbsp; &gt; 내카드에서 변경하실 수 있습니다</font></p>","sortOrdr":"1","frstRgstDt":"2024-05-31"},{"rownum":46,"nttSn":"NTT00000000000081229","nttSj":"카드사가 변경된 경우 카드 변경 방법 및 변경 시 지급 안내","faqCtgry":"CT04","faqAnswer":"<p><b style=\"background-color: transparent; margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: none;\">모두의카드 이용중 카드사가 변경될 경우에는&nbsp;<span style=\"background-color: transparent; margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: none;\">모두의카드</span>에 변경된 카드정보를 직접 등록해주셔야 합니다.&nbsp;</b></p><h5 style=\"margin-right: 0px; margin-bottom: 0px; margin-left: 0px; padding: 0px; border: 0px; vertical-align: baseline; font-size: 1em; font-weight: inherit; outline: none;\"><font color=\"#ff0000\" style=\"outline: none;\"><b style=\"margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: none;\"><span style=\"background-color: transparent;\">모두의카드</span>에 변경된 카드 정보를 등록하신 일자부터 적립되며,</b></font></h5><h5 style=\"margin-right: 0px; margin-bottom: 0px; margin-left: 0px; padding: 0px; border: 0px; vertical-align: baseline; font-size: 1em; font-weight: inherit; outline: none;\"><font color=\"#ff0000\" style=\"outline: none;\"><b style=\"margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: none;\">변경 등록 없이 이용하신 내역에 대해서는 적립되지 않습니다.&nbsp;</b></font></h5><h5 style=\"margin-right: 0px; margin-bottom: 0px; margin-left: 0px; padding: 0px; border: 0px; vertical-align: baseline; font-size: 1em; font-weight: inherit; outline: none;\"><font color=\"#ff0000\" style=\"outline: none;\"><b style=\"margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: none;\"><span style=\"background-color: transparent;\">모두의카드</span>&nbsp;적립금은 [사용중]으로&nbsp; 등록된 카드로 이용하셔야 적립됩니다.&nbsp;</b></font></h5><p style=\"margin-bottom: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: none;\"><br></p><p><br></p><p>1. 카드 변경 방법&nbsp;</p><p>- MY &gt; 내카드 화면에서 [카드변경] 버튼 클릭</p><p>- 변경된 카드번호 입력 후 유효성 검증 완료 시 변경됩니다</p><p><br></p><p>2. 카드 변경에 따른 지급 예시</p><p>1. 1일~말일까지 AA카드사를 이용</p><p>2. 월 초 BB카드로 변경</p><p>3. 익월 초 지급 카드사 확인 시 BB카드사로 확인</p><p>4. AA카드로 적립한 적립금액 BB카드사로 지급 요청</p><p><br></p><p>3. 지급요청된 카드사 확인</p><p>- 지급 요청된 카드사는 MY &gt; 지급내역에서 확인하실 수 있습니다</p><p>- 지급내역은 정산일 이후 카드사별 순차적으로 반영됩니다</p><p><br></p><h6 style=\"margin-bottom: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: none; color: rgb(34, 34, 34); font-family: Pretendard, sans-serif; font-size: 16px;\"><b>*<span style=\"color: rgb(40, 50, 60); font-family: arial, verdana, tahoma, helvetica, sans-serif; font-size: 15px; font-variant-ligatures: none;\">월 3회 변경(1일~말일 기준). 가입 당월 카드 변경 2회 가능합니다.</span></b><br>*동일 카드사 재발급 또는 교체발급의 경우에도 내카드에서 재등록 후 이용해 주세요.<br></h6>","sortOrdr":"1","frstRgstDt":"2024-03-28"},{"rownum":52,"nttSn":"NTT00000000000081220","nttSj":"적립기준(적립 가능한 대중교통 수단)","faqCtgry":"CT02","faqAnswer":"<p><b>1. 적립기준</b></p><p><b>- 모두의카드로 대중교통 이용 시 교통비의 20% 적립</b></p><p><b>- 만 19~34세의 청년층은 30% , 저소득층은 53% 적립, 만 65세 이상 어르신은 30% 적립</b></p><p><b><br></b></p><p><b>2. 적립 가능한 운송수단</b></p><p><b>- 노선버스: 마을버스, 시내버스, 광역버스(시외버스, 고속버스 제외)</b></p><p><b>- 광역(도시)철도: 수도권, 부산, 대구, 광주, 대전, 대경선, GTX, 신분당선 등</b></p><p><span style=\"background-color: rgb(255, 255, 0);\"><b><span style=\"color: rgb(40, 50, 60); font-family: arial, verdana, tahoma, helvetica, sans-serif; font-size: 15px; font-variant-ligatures: none;\">★</span>시외버스, 공항버스, KTX, 새마을, 무궁화호, SRT 등&nbsp;<span style=\"color: rgb(40, 50, 60); font-family: arial, verdana, tahoma, helvetica, sans-serif; font-size: 15px; font-variant-ligatures: none;\">별도로 발권받아 탑승하는 교통수단,&nbsp;</span></b></span></p><p><span style=\"color: rgb(40, 50, 60); font-family: arial, verdana, tahoma, helvetica, sans-serif; font-size: 15px; font-variant-ligatures: none; background-color: rgb(255, 255, 0);\"><b>&nbsp; &nbsp; 타 교통수단과 환승할인이 적용되지 않는 교통수단은 적립되지 않습니다.&nbsp;</b></span></p><p><span style=\"color: rgb(40, 50, 60); font-family: arial, verdana, tahoma, helvetica, sans-serif; font-size: 15px; font-variant-ligatures: none; background-color: transparent;\"><br></span></p>","sortOrdr":"1","frstRgstDt":"2024-03-28"},{"rownum":12,"nttSn":"NTT00000000000081465","nttSj":"하루에 여러 번 이용해도 모두 혜택이 적용되나요?","faqCtgry":"CT05","faqAnswer":"<p>2026년 1월 1일부터 1일 이용 횟수 제한이 없어졌습니다.</p><p>같은 날 여러 번 대중교통을 이용하더라도</p><p>모든 이용 내역이 혜택 적립 대상이 됩니다.</p>","sortOrdr":"2","frstRgstDt":"2025-12-23"},{"rownum":15,"nttSn":"NTT00000000000081462","nttSj":"지자체 혜택이 있는 경우, 모두의카드 혜택이 추가로 지원되나요?","faqCtgry":"CT05","faqAnswer":"<p>일부 지자체에서는&nbsp;<span style=\"background-color: transparent;\">청년 연령 기준을 확대하여 모두의카드 혜택 금액을 추가로 지원하는 정책을 운영하고 있습니다.</span></p><p><span style=\"background-color: transparent;\">해당 지자체에 거주하는 경우, 기본형 또는 모두의카드 혜택 계산 시 지자체 추가 지원 금액이 함께 반영됩니다.</span></p><p><span style=\"background-color: transparent;\"><br></span></p><p><span style=\"background-color: transparent;\">모두의카드 추가 지원 지자체 : 경기, 인천, 경남, 전남광주통합특별시 자치구, 울산</span></p>","sortOrdr":"2","frstRgstDt":"2025-12-23"},{"rownum":59,"nttSn":"NTT00000000000081212","nttSj":"저소득층 적립금액 상향 신청/해지 방법","faqCtgry":"CT01","faqAnswer":"<div>1. 접수 방법</div><div>- 회원가입 시 자동 조회</div><div>- MY &gt; 저소득 신청 메뉴</div><div><br></div><div>2. 접수 대상</div><div>- 기초생활수급자</div><div>- 차상위계층대상자</div><div><br></div><div>3. 검증 방법</div><div>- 주민등록번호 조회(실시간)</div><div>- 증빙서류 등록(비실시간)&nbsp;</div><div>&nbsp; &gt; 기초생활수급자 증빙서류</div><div>&nbsp; &gt; 차상위계층증빙서류</div><div>&nbsp; &gt; 서류 등록은 K-패스 홈페이지를 통해서 등록하실 수 있습니다.&nbsp;</div><div><br></div><div>4. 저소득 상향 적립금 적용</div><div>- 주민등록번호 조회 : 검증일부터 상향 적용</div><div>- 증빙서류 등록 : 서류 등록일부터</div><div><span style=\"background-color: rgb(255, 255, 0);\"><b>*&nbsp;[모두의카드</b><b style=\"\"><b style=\"\">&nbsp;-</b> M</b></span><b style=\"background-color: rgb(255, 255, 0);\">Y - 저소득정보]에 신청결과 &lt;혜택 적용중&gt;</b><b style=\"background-color: rgb(255, 255, 0);\">으로 되어있다면 심사 완료된 상태이며, 추가로 서류를 등록하실 수 없습니다.&nbsp;</b></div><div><br></div><div>5.<b> 해지 방법</b></div><div><b>&nbsp;&nbsp;모두의카드<b>&nbsp;회</b>원은 저소득/차상위 자격 변동이 발생한 경우 지체 없이 회원정보에 최신의 정보로 수정해야 합니다.</b></div><div><b>- 고객센터 문의 031-427-4415 또는 1:1문의 게시판에 \"저소득 해지\"로 남겨주시기 바랍니다.</b></div>","sortOrdr":"2","frstRgstDt":"2024-03-27"},{"rownum":1,"nttSn":"NTT00000000000081559","nttSj":"국민 노리체크카드를 모두의카드로 쓸 수 있나요?","faqCtgry":"CT04","faqAnswer":"<div class=\"markdown\" style=\"margin: 0px; padding: 0px; display: inline; font-family: arial, verdana, tahoma, helvetica, sans-serif; font-size: 15px; font-variant-ligatures: none;\"><font color=\"#28323c\">모두의카드는&nbsp;</font><span style=\"color: rgb(40, 50, 60);\">모두의카드&nbsp;</span><font color=\"#28323c\">소개에 등록된 K-패스 전용 카드만 적립이 가능합니다.</font><br><font color=\"#ff0000\">노리체크카드는&nbsp;모두의카드&nbsp;전용 카드가 아니므로 적립이 불가능</font></div><div class=\"markdown\" style=\"margin: 0px; padding: 0px; display: inline; color: rgb(40, 50, 60); font-family: arial, verdana, tahoma, helvetica, sans-serif; font-size: 15px; font-variant-ligatures: none;\">한 점 이용에 참고 부탁드립니다.</div>","sortOrdr":"","frstRgstDt":"2026-06-11"},{"rownum":2,"nttSn":"NTT00000000000081526","nttSj":"[사용중]으로 등록된 카드로 이용하셔야 적립됩니다. ","faqCtgry":"CT02","faqAnswer":"<p><br></p><p><span style=\"color: rgb(40, 50, 60); font-family: arial, verdana, tahoma, helvetica, sans-serif; font-size: 15px; font-variant-ligatures: none; background-color: transparent;\"><b>모두의카드</b></span><b>&nbsp;적립금은 <span style=\"background-color: rgb(255, 255, 0);\">[사용중]</span>으로&nbsp; 등록된 카드로 이용하셔야 적립됩니다.&nbsp;</b></p><p><br></p><p>이용 중인 카드사 변경/카드번호 변경 시 [내카드]에 변경된 카드 정보 등록 후 이용해주세요.&nbsp;</p><p><span style=\"color: rgb(40, 50, 60); font-family: arial, verdana, tahoma, helvetica, sans-serif; font-size: 15px; font-variant-ligatures: none; background-color: transparent;\">모두의카드</span>에 변경된 카드 정보를 등록하신 일자부터 적립되며, 변경 등록 없이 이용하신 내역에 대해서는 적립되지 않습니다.&nbsp;</p><p><br></p><p><span style=\"color: rgb(40, 50, 60); font-family: arial, verdana, tahoma, helvetica, sans-serif; font-size: 15px; font-variant-ligatures: none;\">카드 변경은 월 3회 변경(1일~말일 기준). 가입 당월 카드 변경 2회 가능합니다.</span></p><p>*카드변경방법 [<span style=\"color: rgb(40, 50, 60); font-family: arial, verdana, tahoma, helvetica, sans-serif; font-size: 15px; font-variant-ligatures: none;\">모두의카드</span>&nbsp;앱/ 홈페이지 &gt; 로그인 &gt; MY &gt;&nbsp; 내카드 &gt; 카드변경 및 이력 &gt; 카드번호 입력 후 카드 유효성 체크 &gt; 하단의 저장 클릭] 진행하실 수 있습니다.&nbsp;</p><p><br></p><p><br></p>","sortOrdr":"","frstRgstDt":"2026-04-17"},{"rownum":6,"nttSn":"NTT00000000000081512","nttSj":"외국인에서 내국인으로 귀화 후 회원 정보가 변경되었어요!","faqCtgry":"CT01","faqAnswer":"<p>외국인에서 내국인으로 귀화하신 경우, 기존에 가입하실 때 사용한 외국인등록번호와 현재의 주민등록번호가 달라 본인인증이 정상적으로 이루어지지 않을 수 있습니다.</p><p>이 경우 고객센터를 통해 회원정보 수정이 필요하오니 콜센터 또는 1:1 문의 게시판을 통해 문의해주세요.</p>","frstRgstDt":"2026-03-20"}]}