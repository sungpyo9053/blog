[Unit]
Description=Store approved articles as WordPress scheduled posts
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HOME=/home/ubuntu
Environment=CODEX_HOME=/home/ubuntu/.codex
Environment=PATH=/home/ubuntu/.local/share/huntlab-mcp/node_modules/.bin:/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python /home/ubuntu/apps/huntlab-blog/scripts/schedule_editorial_queue.py
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
