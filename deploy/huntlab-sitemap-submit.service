[Unit]
Description=HuntLab resubmit sitemaps to Search Console after daily publish

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HOME=/home/ubuntu
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=120
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python scripts/submit_sitemaps.py
