[Unit]
Description=Collect editorial technology news feeds for Hunt News
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python /home/ubuntu/apps/huntlab-blog/scripts/collect_editorial_sources.py
StandardOutput=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-editorial-sources.out.log
StandardError=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-editorial-sources.err.log
