[Unit]
Description=Collect bounded Whereispost demand signals for Hunt News
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ExecStart=/usr/bin/xvfb-run -a /home/ubuntu/apps/huntlab-blog/.venv/bin/python /home/ubuntu/apps/huntlab-blog/scripts/collect_whereispost_cache.py --batch-size 3 --show-browser
StandardOutput=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-whereispost.out.log
StandardError=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-whereispost.err.log
