# DEPRECATED: macOS에서는 deploy/com.huntlab.daily-pipeline.plist와 launchd를 사용한다.
# 이 파일은 과거 Cron 예시 보존용이며 신규 설치에 사용하지 않는다.
# Hunt News daily pipeline — Asia/Seoul 기준 매일 02:00
CRON_TZ=Asia/Seoul
0 2 * * * /Users/sungpyo/blog/scripts/run_daily_pipeline_cron.sh >> /Users/sungpyo/blog/logs/cron.log 2>&1 # HUNTLAB_DAILY_PIPELINE
