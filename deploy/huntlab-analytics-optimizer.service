[Unit]
Description=HuntLab analytics optimizer
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HOME=/home/ubuntu
Environment=CODEX_HOME=/home/ubuntu/.codex
Environment=PATH=/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python /home/ubuntu/apps/huntlab-blog/scripts/run_analytics_optimizer.py
StandardOutput=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-analytics.out.log
StandardError=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-analytics.err.log

[Install]
WantedBy=multi-user.target
