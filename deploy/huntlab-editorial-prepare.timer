[Unit]
Description=Prepare reviewed Physical AI articles without WordPress writes

[Timer]
OnCalendar=*-*-* 02,14:02:00 Asia/Seoul
# editorial-schedule runs at *:0/5:30 and shares the pipeline lock; keep clear of it.
AccuracySec=1s
Persistent=false
Unit=huntlab-editorial-prepare.service

[Install]
WantedBy=timers.target
