[Unit]
Description=Report weekly editorial service failure without retrying updates

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=PATH=/home/ubuntu/.local/share/huntlab-mcp/node_modules/.bin:/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=MCPORTER_BIN=/home/ubuntu/.local/share/huntlab-mcp/node_modules/.bin/mcporter
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
TimeoutStartSec=90
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python scripts/report_weekly_editorial_failure.py
