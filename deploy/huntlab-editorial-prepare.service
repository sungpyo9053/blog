[Unit]
Description=Prepare one reviewed Physical AI article for the editorial queue
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HUNTLAB_AGENT_RUNTIME=claude
Environment=HUNTLAB_AGENT_BIN=/home/ubuntu/.local/bin/claude
Environment=HUNTLAB_CLAUDE_MODEL=claude-opus-5-5
Environment=HUNTLAB_CLAUDE_EFFORT=high
EnvironmentFile=/home/ubuntu/.config/huntlab/claude.env
Environment=HOME=/home/ubuntu
Environment=CODEX_HOME=/home/ubuntu/.codex
Environment=HUNTLAB_CODEX_MODEL=gpt-5.6-terra
Environment=HUNTLAB_CODEX_REASONING=high
Environment=PATH=/home/ubuntu/.local/share/huntlab-mcp/node_modules/.bin:/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=MCPORTER_BIN=/home/ubuntu/.local/share/huntlab-mcp/node_modules/.bin/mcporter
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
TimeoutStartSec=5h
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python /home/ubuntu/apps/huntlab-blog/scripts/run_evidence_deep_article.py --apply --prepare-only
StandardOutput=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-editorial-prepare.out.log
StandardError=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-editorial-prepare.err.log
