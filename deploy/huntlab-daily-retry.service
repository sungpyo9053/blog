[Unit]
Description=Retry HuntLab daily pipeline only after a missing or failed daily run
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HOME=/home/ubuntu
Environment=CODEX_HOME=/home/ubuntu/.codex
Environment=PATH=/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python /home/ubuntu/apps/huntlab-blog/scripts/retry_daily_pipeline.py
StandardOutput=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-daily-retry.out.log
StandardError=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-daily-retry.err.log
