[Unit]
Description=HuntLab daily blog content pipeline
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HUNTLAB_AGENT_RUNTIME=claude
Environment=HUNTLAB_AGENT_BIN=/home/ubuntu/.local/bin/claude
Environment=HUNTLAB_CLAUDE_MODEL=claude-opus-5-5
Environment=HUNTLAB_CLAUDE_EFFORT=high
EnvironmentFile=/home/ubuntu/.config/huntlab/claude.env
Environment=HOME=/home/ubuntu
Environment=CODEX_HOME=/home/ubuntu/.codex
Environment=PATH=/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ExecStartPre=/home/ubuntu/apps/huntlab-blog/.venv/bin/python /home/ubuntu/apps/huntlab-blog/scripts/collect_editorial_sources.py
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python /home/ubuntu/apps/huntlab-blog/scripts/run_daily_pipeline.py --use-google-trends-cache --use-editorial-source-cache --briefing-only --topic-workers 2
StandardOutput=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-daily.out.log
StandardError=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-daily.err.log

[Install]
WantedBy=multi-user.target
