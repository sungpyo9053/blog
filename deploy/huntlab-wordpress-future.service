[Unit]
Description=Publish only due WordPress future posts
After=network.target mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/html
# Scans due future posts directly; lost publish_future_post cron events left
# posts 822/845 unpublished (2026-09-28, 2026-10-03).
ExecStart=/usr/local/bin/wp --path=/var/www/html eval-file /usr/local/lib/huntlab/publish-due-future.php
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

