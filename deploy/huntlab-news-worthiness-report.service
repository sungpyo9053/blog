[Unit]
Description=Hunt News 14-day Shadow ranking report
After=huntlab-daily-pipeline.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python /home/ubuntu/apps/huntlab-blog/scripts/report_news_worthiness_shadow.py --start 2026-08-22 --end 2026-09-04
StandardOutput=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-news-worthiness-report.out.log
StandardError=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-news-worthiness-report.err.log
