[Unit]
Description=Prepare and schedule up to seven independently approved articles
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HOME=/home/ubuntu
Environment=CODEX_HOME=/home/ubuntu/.codex
Environment=HUNTLAB_CODEX_MODEL=gpt-5.6-terra
Environment=HUNTLAB_CODEX_REASONING=high
Environment=PATH=/home/ubuntu/.local/share/huntlab-mcp/node_modules/.bin:/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=MCPORTER_BIN=/home/ubuntu/.local/share/huntlab-mcp/node_modules/.bin/mcporter
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python /home/ubuntu/apps/huntlab-blog/scripts/fill_editorial_schedule.py
TimeoutStartSec=12h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-editorial-fill.out.log
StandardError=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-editorial-fill.err.log
