[Unit]
Description=HuntLab quality remediation schedule reminder

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python /home/ubuntu/apps/huntlab-blog/scripts/run_quality_remediation_schedule.py
StandardOutput=append:/home/ubuntu/apps/huntlab-blog/logs/quality-remediation-schedule.log
StandardError=append:/home/ubuntu/apps/huntlab-blog/logs/quality-remediation-schedule.err.log
