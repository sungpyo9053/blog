[Unit]
Description=Hunt News Kakao self-chat daily report
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/share/huntlab-mcp/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
Environment=MCPORTER_BIN=/home/ubuntu/.local/share/huntlab-mcp/node_modules/.bin/mcporter
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=120
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python scripts/send_kakao_report.py --send

