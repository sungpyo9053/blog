[Unit]
Description=Apply one HuntLab Aug-7 index discovery action
Wants=network-online.target
After=network-online.target huntlab-analytics-optimizer.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python /home/ubuntu/apps/huntlab-blog/scripts/apply_index_discovery_action.py --apply --review-date 2026-08-07
StandardOutput=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-aug7-index-discovery.out.log
StandardError=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-aug7-index-discovery.err.log
