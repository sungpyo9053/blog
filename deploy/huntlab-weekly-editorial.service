[Unit]
Description=HuntLab weekly review and independently approved paragraph maintenance
Wants=network-online.target
After=network-online.target
OnFailure=huntlab-weekly-editorial-failure.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/huntlab-blog
Environment=HUNTLAB_AGENT_RUNTIME=claude
Environment=HUNTLAB_AGENT_BIN=/home/ubuntu/.local/bin/claude
Environment=HUNTLAB_CLAUDE_MODEL=claude-opus-5-5
Environment=HUNTLAB_CLAUDE_EFFORT=high
EnvironmentFile=/home/ubuntu/.config/huntlab/claude.env
Environment=PATH=/home/ubuntu/.local/share/huntlab-mcp/node_modules/.bin:/home/ubuntu/apps/huntlab-blog/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=MCPORTER_BIN=/home/ubuntu/.local/share/huntlab-mcp/node_modules/.bin/mcporter
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
TimeoutStartSec=3600
ExecStart=/home/ubuntu/apps/huntlab-blog/.venv/bin/python scripts/run_weekly_editorial.py --apply --notify
StandardOutput=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-weekly-editorial.out.log
StandardError=append:/home/ubuntu/apps/huntlab-blog/logs/systemd-weekly-editorial.err.log

[Install]
WantedBy=multi-user.target
